# Copy to .env and edit for your machine:
#   cp .env.example .env

NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=express_db_connection

# Students & marks
PASS_PERCENTAGE=33.5
ACADEMIC_YEAR=2026-27

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret!!
ACCESS_TOKEN_TTL_SECONDS=900

# Comma-separated full URLs only — never use "*"
CORS_ORIGINS=http://localhost:3000

# Max POST /api/students/:id/marks requests per user per 10 minutes
MARKS_RATE_LIMIT_MAX=60
